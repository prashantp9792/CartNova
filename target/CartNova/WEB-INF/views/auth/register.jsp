<%@ include file="../common/header.jspf" %><section class="narrow"><div class="auth-brand"><div class="eyebrow">Make yourself at home</div><h1>Create your account</h1><p>Join CartNova as a shopper or start selling.</p></div><form class="form-card" method="post" action="${ctx}/register"><div class="row"><div style="flex:1"><label>First name</label><input name="firstName" required value="<c:out value='${firstName}'/>" autocomplete="given-name"></div><div style="flex:1"><label>Last name</label><input name="lastName" required value="<c:out value='${lastName}'/>" autocomplete="family-name"></div></div><label>Email address</label><input type="email" name="email" required value="<c:out value='${email}'/>" autocomplete="email"><label>Phone (optional)</label><input name="phone" value="<c:out value='${phone}'/>" autocomplete="tel"><label>Account type</label><select name="role"><option value="BUYER">I want to shop</option><option value="SELLER" ${role eq 'SELLER' ? 'selected' : ''}>I want to sell</option></select><label>Password (at least 6 characters)</label><input type="password" name="password" minlength="6" required autocomplete="new-password"><label>Confirm password</label><input type="password" name="confirmPassword" minlength="6" required autocomplete="new-password"><button style="width:100%;margin-top:20px">Create account</button><p class="small">Already have an account? <a href="${ctx}/login">Sign in</a></p></form></section><%@ include file="../common/footer.jspf" %>
