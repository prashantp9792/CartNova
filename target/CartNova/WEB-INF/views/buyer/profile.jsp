<%@ include file="../common/header.jspf" %><div class="eyebrow">Your details</div><h1>Account settings</h1><div class="product-detail"><form class="form-card" method="post" action="${ctx}/profile"><h2>Profile</h2><div class="row"><div style="flex:1"><label>First name</label><input name="firstName" required value="<c:out value='${sessionScope.user.firstName}'/>"></div><div style="flex:1"><label>Last name</label><input name="lastName" required value="<c:out value='${sessionScope.user.lastName}'/>"></div></div><label>Email</label><input value="<c:out value='${sessionScope.user.email}'/>" disabled><label>Phone</label><input name="phone" value="<c:out value='${sessionScope.user.phone}'/>"><label>Address</label><input name="addressLine1" value="<c:out value='${sessionScope.user.addressLine1}'/>"><label>Address line 2</label><input name="addressLine2" value="<c:out value='${sessionScope.user.addressLine2}'/>"><div class="row"><div style="flex:1"><label>City</label><input name="city" value="<c:out value='${sessionScope.user.city}'/>"></div><div style="flex:1"><label>State</label><input name="state" value="<c:out value='${sessionScope.user.state}'/>"></div></div><label>Postal code</label><input name="zipCode" value="<c:out value='${sessionScope.user.zipCode}'/>"><button style="margin-top:18px">Save profile</button></form><form class="form-card" method="post" action="${ctx}/profile"><input type="hidden" name="action" value="changePassword"><h2>Change password</h2><label>Current password</label><input type="password" name="currentPassword" required><label>New password</label><input type="password" name="newPassword" minlength="6" required><label>Confirm new password</label><input type="password" name="confirmPassword" minlength="6" required><button style="margin-top:18px">Update password</button></form></div><%@ include file="../common/footer.jspf" %>
