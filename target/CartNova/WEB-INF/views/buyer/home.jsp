<%@ include file="../common/header.jspf" %>
<section class="hero"><div><div class="eyebrow">A better way to shop</div><h1>Good things, thoughtfully found.</h1><p>Discover everyday essentials, standout tech and personal style from independent sellers you can trust.</p><div class="actions"><a class="btn" href="${ctx}/products">Explore the shop</a><a class="btn secondary" href="${ctx}/register">Create an account</a></div></div><div class="hero-art">🛍️</div></section>
<div class="section-head"><div><div class="eyebrow">Find your next favorite</div><h2>Shop by category</h2></div><a href="${ctx}/products">All products →</a></div><div class="category-grid"><c:forEach var="category" items="${categories}"><a class="category" href="${ctx}/products?category=${category.categoryId}"><c:out value="${category.name}"/> <span>→</span></a></c:forEach></div>
<div class="section-head"><div><div class="eyebrow">Picked for you</div><h2>Featured finds</h2></div><a href="${ctx}/products">Browse all →</a></div><div class="grid"><c:forEach var="product" items="${featuredProducts}"><article class="product"><a href="${ctx}/product?id=${product.productId}"><img src="<c:out value='${product.imageUrl}' default='https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80'/>" alt="<c:out value='${product.name}'/>"></a><div class="product-body"><span class="muted small"><c:out value="${product.categoryName}"/></span><h3><a href="${ctx}/product?id=${product.productId}"><c:out value="${product.name}"/></a></h3><div class="price">₹<fmt:formatNumber value="${product.price}" type="number" maxFractionDigits="2"/></div><div class="small muted">★ <fmt:formatNumber value="${product.averageRating}" maxFractionDigits="1"/> · ${product.reviewCount} reviews</div></div></article></c:forEach></div>
<%@ include file="../common/footer.jspf" %>
