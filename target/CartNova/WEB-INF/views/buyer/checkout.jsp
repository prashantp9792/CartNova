<%@ include file="../common/header.jspf" %><div class="eyebrow">Almost yours</div><h1>Checkout</h1><div class="product-detail"><form class="form-card" method="post" action="${ctx}/checkout"><h2>Delivery address</h2><label>Address line 1</label><input name="addressLine1" required value="<c:out value='${user.addressLine1}'/>"><label>Address line 2</label><input name="addressLine2" value="<c:out value='${user.addressLine2}'/>"><div class="row"><div style="flex:1"><label>City</label><input name="city" required value="<c:out value='${user.city}'/>"></div><div style="flex:1"><label>State</label><input name="state" required value="<c:out value='${user.state}'/>"></div></div><label>Postal code</label><input name="zipCode" required value="<c:out value='${user.zipCode}'/>"><label>Payment method</label><select name="paymentMethod"><option value="COD">Cash on delivery</option><option value="UPI">UPI</option><option value="NET_BANKING">Net banking</option><option value="CARD">Card</option></select><p class="small">Online payment methods are recorded as order preferences; payment capture is not configured.</p><button style="width:100%">Place order</button></form><aside class="panel"><h2>Order summary</h2><c:forEach var="item" items="${cartItems}"><div class="row between"><span><c:out value="${item.product.name}"/> × ${item.quantity}</span><strong>₹<fmt:formatNumber value="${item.subtotal}" maxFractionDigits="2"/></strong></div><hr style="border:0;border-top:1px solid var(--line);margin:16px 0"></c:forEach><div class="row between"><strong>Total</strong><strong>₹<fmt:formatNumber value="${totalAmount}" maxFractionDigits="2"/></strong></div></aside></div><%@ include file="../common/footer.jspf" %>
