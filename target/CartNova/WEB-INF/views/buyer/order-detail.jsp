<%@ include file="../common/header.jspf" %><div class="row between"><div><div class="eyebrow">Purchase details</div><h1>Order #${order.orderId}</h1></div><span class="badge"><c:out value="${order.status}"/></span></div><div class="product-detail"><section class="panel"><h2>Items</h2><c:forEach var="item" items="${order.items}"><div class="row between"><span><c:out value="${item.productName}"/> × ${item.quantity}</span><strong>₹<fmt:formatNumber value="${item.subtotal}" maxFractionDigits="2"/></strong></div><hr style="border:0;border-top:1px solid var(--line);margin:15px 0"></c:forEach><div class="row between"><strong>Total</strong><strong>₹<fmt:formatNumber value="${order.totalAmount}" maxFractionDigits="2"/></strong></div></section><aside class="panel"><h2>Delivery</h2><p><c:out value="${order.shippingAddress}"/></p><p>Placed <fmt:formatDate value="${order.orderDate}" pattern="MMMM d, yyyy 'at' h:mm a"/></p><a href="${ctx}/orders">← All orders</a></aside></div><%@ include file="../common/footer.jspf" %>
