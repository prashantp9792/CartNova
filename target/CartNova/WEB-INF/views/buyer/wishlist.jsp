<%@ include file="../common/header.jspf" %><div class="eyebrow">Saved for later</div><h1>Your wishlist</h1><c:choose><c:when test="${empty wishlistItems}"><div class="empty"><h2>Keep the good ones close</h2><p>Save products as you browse and they’ll appear here.</p><a class="btn" href="${ctx}/products">Browse the shop</a></div></c:when><c:otherwise><div class="grid"><c:forEach var="item" items="${wishlistItems}"><article class="product"><a href="${ctx}/product?id=${item.product.productId}"><img src="<c:out value='${item.product.imageUrl}'/>" alt="<c:out value='${item.product.name}'/>"></a><div class="product-body"><h3><a href="${ctx}/product?id=${item.product.productId}"><c:out value="${item.product.name}"/></a></h3><div class="price">₹<fmt:formatNumber value="${item.product.price}" maxFractionDigits="2"/></div><div class="row" style="margin-top:12px"><form method="post" action="${ctx}/wishlist"><input type="hidden" name="productId" value="${item.product.productId}"><input type="hidden" name="action" value="moveToCart"><button>Add to cart</button></form><form method="post" action="${ctx}/wishlist"><input type="hidden" name="productId" value="${item.product.productId}"><input type="hidden" name="action" value="remove"><button class="secondary">Remove</button></form></div></div></article></c:forEach></div></c:otherwise></c:choose><%@ include file="../common/footer.jspf" %>
