<%@ include file="../common/header.jspf" %><div class="eyebrow">Your picks</div><h1>Shopping cart</h1><c:choose><c:when test="${empty cartItems}"><div class="empty"><h2>Your cart is ready for something good</h2><p>Browse the shop and add an item to get started.</p><a class="btn" href="${ctx}/products">Explore products</a></div></c:when><c:otherwise><div class="panel"><div class="table-wrap"><table class="table"><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody><c:forEach var="item" items="${cartItems}"><tr><td><a href="${ctx}/product?id=${item.productId}"><c:out value="${item.product.name}"/></a></td><td>₹<fmt:formatNumber value="${item.product.price}" maxFractionDigits="2"/></td><td><form class="row" method="post" action="${ctx}/cart"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="${item.productId}"><input style="width:82px" type="number" name="quantity" value="${item.quantity}" min="1" max="${item.product.stockQuantity}"><button>Update</button></form></td><td>₹<fmt:formatNumber value="${item.subtotal}" maxFractionDigits="2"/></td><td><form method="post" action="${ctx}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${item.productId}"><button class="danger">Remove</button></form></td></tr></c:forEach></tbody></table></div><div class="row between" style="margin-top:22px"><a href="${ctx}/products">← Continue shopping</a><div class="row"><strong>Grand total: ₹<fmt:formatNumber value="${grandTotal}" maxFractionDigits="2"/></strong><a class="btn" href="${ctx}/checkout">Checkout</a></div></div></div></c:otherwise></c:choose><%@ include file="../common/footer.jspf" %>
