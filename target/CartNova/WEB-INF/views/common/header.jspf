<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${requestScope.pageTitle}" default="CartNova"/> · CartNova</title><link rel="stylesheet" href="${ctx}/assets/css/app.css"></head><body>
<header class="topbar"><a class="brand" href="${ctx}/home">Cart<span>Nova</span></a><form class="search" action="${ctx}/products"><input name="q" placeholder="Search products…" value="<c:out value='${param.q}'/>" aria-label="Search products"><button>Search</button></form><nav><a href="${ctx}/products">Shop</a><c:if test="${not empty sessionScope.user}"><a href="${ctx}/cart">Cart</a><a href="${ctx}/orders">Orders</a><a href="${ctx}/profile">Account</a><c:if test="${sessionScope.role eq 'SELLER'}"><a href="${ctx}/seller/dashboard">Seller</a></c:if><c:if test="${sessionScope.role eq 'ADMIN'}"><a href="${ctx}/admin/dashboard">Admin</a></c:if><a href="${ctx}/logout">Sign out</a></c:if><c:if test="${empty sessionScope.user}"><a href="${ctx}/login">Sign in</a><a class="nav-cta" href="${ctx}/register">Join free</a></c:if></nav></header>
<main class="container"><c:if test="${not empty sessionScope.success}"><div class="notice success"><c:out value="${sessionScope.success}"/><c:remove var="success" scope="session"/></div></c:if><c:if test="${not empty requestScope.success}"><div class="notice success"><c:out value="${requestScope.success}"/></div></c:if><c:if test="${not empty requestScope.error}"><div class="notice error"><c:out value="${requestScope.error}"/></div></c:if><c:if test="${not empty sessionScope.error}"><div class="notice error"><c:out value="${sessionScope.error}"/><c:remove var="error" scope="session"/></div></c:if>
