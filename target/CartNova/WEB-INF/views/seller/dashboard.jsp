<%@ include file="../common/header.jspf" %><div class="eyebrow">Seller studio</div><h1>Welcome back, <c:out value="${sessionScope.user.firstName}"/></h1><p>Your shop at a glance.</p><div class="stats"><div class="stat"><span class="muted">Products</span><strong>${totalProducts}</strong></div><div class="stat"><span class="muted">Orders</span><strong>${totalOrders}</strong></div><div class="stat"><span class="muted">Revenue</span><strong>₹<fmt:formatNumber value="${totalRevenue}" maxFractionDigits="0"/></strong></div><div class="stat"><span class="muted">Low stock</span><strong>${lowStockProductCount}</strong></div></div><div class="section-head"><div><div class="eyebrow">Your shop</div><h2>Manage your business</h2></div></div><div class="row"><a class="btn" href="${ctx}/seller/products?action=add">Add a product</a><a class="btn secondary" href="${ctx}/seller/products">Products</a><a class="btn secondary" href="${ctx}/seller/orders">Orders</a><a class="btn secondary" href="${ctx}/seller/reports">Reports</a><a class="btn secondary" href="${ctx}/seller/inventory">Inventory</a></div><h2 class="section-head">Recent orders</h2><div class="panel table-wrap"><table class="table"><thead><tr><th>Order</th><th>Buyer</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody><c:forEach var="order" items="${recentOrders}"><tr><td>#${order.orderId}</td><td><c:out value="${order.buyerName}"/></td><td><fmt:formatDate value="${order.orderDate}" pattern="MMM d, yyyy"/></td><td><c:out value="${order.status}"/></td><td>₹<fmt:formatNumber value="${order.totalAmount}" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jspf" %>
