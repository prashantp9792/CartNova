<%@ include file="../common/header.jspf" %><div class="narrow"><div class="eyebrow">Seller studio</div><h1>${empty product ? 'Add a product' : 'Edit product'}</h1><form class="form-card" method="post" action="${ctx}/seller/products"><c:if test="${not empty product}"><input type="hidden" name="productId" value="${product.productId}"></c:if><label>Product name</label><input name="name" required value="<c:out value='${product.name}'/>"><label>Category</label><select name="categoryId" required><c:forEach var="c" items="${categories}"><option value="${c.categoryId}" ${product.categoryId eq c.categoryId ? 'selected' : ''}><c:out value="${c.name}"/></option></c:forEach></select><div class="row"><div style="flex:1"><label>Price (₹)</label><input name="price" type="number" min="0.01" step="0.01" required value="<c:out value='${product.price}'/>"></div><div style="flex:1"><label>Stock quantity</label><input name="stockQuantity" type="number" min="0" required value="<c:out value='${product.stockQuantity}' default='0'/>"></div></div><label>Brand</label><input name="brand" value="<c:out value='${product.brand}'/>"><label>Image URL</label><input type="url" name="imageUrl" value="<c:out value='${product.imageUrl}'/>" placeholder="https://"><label>Description</label><textarea name="description"><c:out value="${product.description}"/></textarea><label><input type="checkbox" name="active" ${empty product or product.active ? 'checked' : ''} style="width:auto"> Product is visible in the shop</label><button style="margin-top:18px">Save product</button> <a class="btn secondary" href="${ctx}/seller/products">Cancel</a></form></div><%@ include file="../common/footer.jspf" %>
