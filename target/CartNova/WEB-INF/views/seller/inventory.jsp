<%@ include file="../common/header.jspf" %><div class="eyebrow">Seller studio</div><h1>Inventory</h1><p>Keep an eye on availability across your catalog.</p><div class="panel table-wrap"><table class="table"><thead><tr><th>Product</th><th>Stock</th><th>Availability</th><th>Adjust stock</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td><c:out value="${p.name}"/></td><td>${p.stockQuantity}</td><td><span class="badge">${p.stockQuantity le 5 ? 'Low stock' : 'Healthy'}</span></td><td><form class="row" method="post" action="${ctx}/seller/inventory"><input type="hidden" name="productId" value="${p.productId}"><input style="width:100px" type="number" min="0" name="stockQuantity" value="${p.stockQuantity}" required><button>Save</button></form></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jspf" %>
