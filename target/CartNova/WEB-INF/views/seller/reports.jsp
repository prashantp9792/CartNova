<%@ include file="../common/header.jspf" %><div class="eyebrow">Seller studio</div><h1>Shop reports</h1><div class="stats"><div class="stat"><span class="muted">Products</span><strong>${products.size()}</strong></div><div class="stat"><span class="muted">Orders</span><strong>${totalOrders}</strong></div><div class="stat"><span class="muted">Revenue</span><strong>₹<fmt:formatNumber value="${revenue}" maxFractionDigits="0"/></strong></div></div><div class="section-head"><div><div class="eyebrow">Performance</div><h2>Recent sales</h2></div></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Revenue</th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#${order.orderId}</td><td><fmt:formatDate value="${order.orderDate}" pattern="MMM d, yyyy"/></td><td><c:out value="${order.status}"/></td><td>₹<fmt:formatNumber value="${order.totalAmount}" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jspf" %>
