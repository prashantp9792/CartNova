<%@ include file="../common/header.jspf" %><div class="eyebrow">CartNova control room</div><h1>Platform overview</h1><div class="stats"><div class="stat"><span class="muted">Users</span><strong>${stats.totalUsers}</strong></div><div class="stat"><span class="muted">Sellers</span><strong>${stats.totalSellers}</strong></div><div class="stat"><span class="muted">Products</span><strong>${stats.totalProducts}</strong></div><div class="stat"><span class="muted">Orders</span><strong>${stats.totalOrders}</strong></div></div><div class="row" style="margin:24px 0"><a class="btn" href="${ctx}/admin/users">Manage users</a></div><div class="product-detail"><section><h2>Recent orders</h2><div class="panel table-wrap"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody><c:forEach var="o" items="${recentOrders}"><tr><td>#${o.orderId}</td><td><c:out value="${o.buyerName}"/></td><td>${o.status}</td><td>₹<fmt:formatNumber value="${o.totalAmount}" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div></section><section><h2>Recent users</h2><div class="panel table-wrap"><table class="table"><thead><tr><th>Name</th><th>Role</th><th>Email</th></tr></thead><tbody><c:forEach var="u" items="${recentUsers}"><tr><td><c:out value="${u.fullName}"/></td><td>${u.role}</td><td><c:out value="${u.email}"/></td></tr></c:forEach></tbody></table></div></section></div><%@ include file="../common/footer.jspf" %>
