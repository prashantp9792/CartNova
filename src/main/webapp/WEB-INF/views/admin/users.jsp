<%@ include file="../common/header.jspf" %><div class="eyebrow">CartNova control room</div><h1>Manage users</h1><div class="panel table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach var="u" items="${users}"><tr><td><c:out value="${u.fullName}"/></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.role}"/></td><td>${u.active ? 'Active' : 'Disabled'}</td><td><form class="row" method="post" action="${ctx}/admin/users"><input type="hidden" name="userId" value="${u.userId}"><input type="hidden" name="action" value="toggleStatus"><input type="hidden" name="active" value="${!u.active}"><button class="secondary">${u.active ? 'Deactivate' : 'Activate'}</button></form></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jspf" %>
