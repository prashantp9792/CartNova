<%@ include file="../common/header.jspf" %><div class="row between"><div><div class="eyebrow">Seller studio</div><h1>Your products</h1></div><a class="btn" href="${ctx}/seller/products?action=add">＋ Add product</a></div><c:choose><c:when test="${empty products}"><div class="empty"><h2>Your catalog starts here</h2><p>Add your first product to open your shop.</p><a class="btn" href="${ctx}/seller/products?action=add">Add a product</a></div></c:when><c:otherwise><div class="panel table-wrap"><table class="table"><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td><c:out value="${p.name}"/><div class="muted small"><c:out value="${p.categoryName}"/></div></td><td>₹<fmt:formatNumber value="${p.price}" maxFractionDigits="2"/></td><td>${p.stockQuantity}</td><td>${p.active ? 'Active' : 'Hidden'}</td><td><a href="${ctx}/seller/products?action=edit&id=${p.productId}">Edit</a> · <form class="inline" method="post" action="${ctx}/seller/products" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="productId" value="${p.productId}"><button class="danger">Delete</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose><%@ include file="../common/footer.jspf" %>
