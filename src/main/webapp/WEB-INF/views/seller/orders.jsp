<%@ include file="../common/header.jspf" %><div class="eyebrow">Seller studio</div><h1>Customer orders</h1><div class="panel table-wrap"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Status</th><th>Update</th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#${order.orderId}</td><td><c:out value="${order.buyerName}"/><div class="small muted"><c:out value="${order.buyerEmail}"/></div></td><td><fmt:formatDate value="${order.orderDate}" pattern="MMM d, yyyy"/></td><td><c:out value="${order.status}"/></td><td><form class="row" method="post" action="${ctx}/seller/orders"><input type="hidden" name="orderId" value="${order.orderId}"><select name="status"><option>PENDING</option><option>CONFIRMED</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button>Save</button></form></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jspf" %>
