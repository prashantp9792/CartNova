<%@ include file="../common/header.jspf" %><div class="eyebrow">The CartNova edit</div><h1>Find something good.</h1><p>Explore products from our community of independent sellers.</p>
<form class="filters" action="${ctx}/products"><div><label>Search</label><input name="q" value="<c:out value='${query}'/>" placeholder="Name, brand, keyword"></div><div><label>Category</label><select name="category"><option value="">All categories</option><c:forEach var="c" items="${categories}"><option value="${c.categoryId}" ${selectedCategory eq c.categoryId ? 'selected' : ''}><c:out value="${c.name}"/></option></c:forEach></select></div><div><label>Min price</label><input type="number" step="0.01" min="0" name="minPrice" value="<c:out value='${minPrice}'/>" placeholder="₹0"></div><div><label>Max price</label><input type="number" step="0.01" min="0" name="maxPrice" value="<c:out value='${maxPrice}'/>" placeholder="Any"></div><div><label>Sort</label><select name="sort"><option value="rating">Popular</option><option value="price_asc" ${sort eq 'price_asc' ? 'selected' : ''}>Price: low to high</option><option value="price_desc" ${sort eq 'price_desc' ? 'selected' : ''}>Price: high to low</option><option value="newest" ${sort eq 'newest' ? 'selected' : ''}>Newest</option></select><button>Apply</button></div></form>
<c:choose><c:when test="${empty products}"><div class="empty"><h2>No products found</h2><p>Try another search or clear your filters.</p><a class="btn" href="${ctx}/products">Clear filters</a></div></c:when><c:otherwise><div class="grid"><c:forEach var="product" items="${products}"><article class="product"><a href="${ctx}/product?id=${product.productId}"><img src="<c:out value='${product.imageUrl}' default='https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80'/>" alt="<c:out value='${product.name}'/>"></a><div class="product-body"><span class="muted small"><c:out value="${product.categoryName}"/></span><h3><a href="${ctx}/product?id=${product.productId}"><c:out value="${product.name}"/></a></h3><div class="price">₹<fmt:formatNumber value="${product.price}" type="number" maxFractionDigits="2"/></div><p>★ <fmt:formatNumber value="${product.averageRating}" maxFractionDigits="1"/> · <c:out value="${product.brand}"/></p><a class="btn secondary" href="${ctx}/product?id=${product.productId}">View details</a></div></article></c:forEach></div></c:otherwise></c:choose><%@ include file="../common/footer.jspf" %>
