<%@ include file="../common/header.jspf" %><div class="product-detail"><div><img src="<c:out value='${product.imageUrl}' default='https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=900&q=80'/>" alt="<c:out value='${product.name}'/>"></div><section><div class="eyebrow"><c:out value="${product.categoryName}"/></div><h1><c:out value="${product.name}"/></h1><p>By <c:out value="${product.sellerName}"/> · <c:out value="${product.brand}"/></p><div class="price">₹<fmt:formatNumber value="${product.price}" maxFractionDigits="2"/></div><p>★ <fmt:formatNumber value="${product.averageRating}" maxFractionDigits="1"/> · ${product.reviewCount} reviews</p><p><c:out value="${product.description}"/></p><p><c:choose><c:when test="${product.inStock}"><span class="badge">In stock · ${product.stockQuantity} available</span></c:when><c:otherwise><span class="badge">Currently unavailable</span></c:otherwise></c:choose></p><c:if test="${product.inStock}"><form class="row" method="post" action="${ctx}/cart"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.productId}"><input style="width:90px" type="number" name="quantity" value="1" min="1" max="${product.stockQuantity}"><button>Add to cart</button></form></c:if><c:if test="${not empty sessionScope.user}"><form method="post" action="${ctx}/wishlist" style="margin-top:12px"><input type="hidden" name="action" value="toggle"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="redirect" value="${ctx}/product?id=${product.productId}"><button class="secondary">${inWishlist ? '♥ Saved to wishlist' : '♡ Add to wishlist'}</button></form></c:if></section></div><section id="reviews" class="section-head"><div><div class="eyebrow">Customer notes</div><h2>Reviews</h2></div></section><c:forEach var="review" items="${reviews}"><article class="panel" style="margin-bottom:12px"><strong><c:out value="${review.userName}"/></strong> · ${review.rating}/5<p><c:out value="${review.comment}"/></p></article></c:forEach><c:if test="${empty reviews}"><p>No reviews yet. Be the first to share a note after your purchase.</p></c:if><c:if test="${not empty sessionScope.user}"><form class="form-card" method="post" action="${ctx}/review"><input type="hidden" name="productId" value="${product.productId}"><label>Your rating</label><select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select><label>Your review</label><textarea name="comment" maxlength="1000" placeholder="What did you think?"></textarea><button>Submit review</button></form></c:if><%@ include file="../common/footer.jspf" %>
